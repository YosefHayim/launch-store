{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "types": ["node"],
    "rootDir": "..",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "paths": {
      "@apple/*": ["../src/apple/*"],
      "@core/*": ["../src/core/*"],
      "@google/*": ["../src/google/*"],
      "@testkit/*": ["../src/testkit/*"]
    }
  },
  "include": ["."]
}
